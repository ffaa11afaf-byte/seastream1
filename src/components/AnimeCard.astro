---
import type { PopularAnime } from "./types";

interface Props {
  anime: PopularAnime;
}

const { anime } = Astro.props;
---

<article class="group cursor-pointer">
  <div
    class="relative aspect-[3/4] overflow-hidden rounded-xl border border-border-subtle bg-card transition-all duration-300 group-hover:border-accent group-hover:-translate-y-1"
  >
    <img
      src={anime.poster}
      alt={anime.title}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-bg/90 via-transparent to-transparent"></div>

    <span
      class="absolute top-2 left-2 inline-flex items-center gap-1 rounded-md bg-bg/80 px-2 py-0.5 text-xs font-bold text-accent backdrop-blur-sm"
    >
      <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z"></path>
      </svg>
      {anime.rating}
    </span>
  </div>

  <div class="mt-3">
    <h3
      class="truncate text-sm font-semibold text-white transition-colors group-hover:text-accent"
    >
      {anime.title}
    </h3>
    <p class="mt-0.5 truncate text-xs text-muted">{anime.genre}</p>
  </div>
</article>
