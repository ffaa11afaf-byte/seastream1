---
import type { FeaturedAnime } from "./types";

interface Props {
  items: FeaturedAnime[];
}

const { items } = Astro.props;
---

<section id="featured" class="py-12">
  <div class="mb-8 flex items-center justify-between">
    <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
      الأنمي المميز
    </h2>
    <div class="flex gap-2">
      <button
        type="button"
        aria-label="السابق"
        class="grid h-10 w-10 place-items-center rounded-lg border border-border-strong text-muted transition-colors hover:border-accent hover:text-accent"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path
            d="M9 6l6 6-6 6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <button
        type="button"
        aria-label="التالي"
        class="grid h-10 w-10 place-items-center rounded-lg border border-border-strong text-muted transition-colors hover:border-accent hover:text-accent"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path
            d="M15 6l-6 6 6 6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:gap-6 md:grid-cols-3">
    {
      items.map((anime, i) => (
        <article class="group relative overflow-hidden rounded-2xl border border-border-subtle bg-card transition-all duration-300 hover:border-accent hover:-translate-y-1">
          <div class="relative aspect-[3/4] overflow-hidden">
            <img
              src={anime.poster}
              alt={anime.title}
              loading={i === 0 ? "eager" : "lazy"}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-bg via-bg/40 to-transparent" />
            <span class="absolute top-3 left-3 inline-flex items-center gap-1 rounded-lg bg-bg/80 px-2.5 py-1 text-xs font-bold text-accent backdrop-blur-sm">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z" />
              </svg>
              {anime.rating}
            </span>
            {i === 0 && (
              <span class="absolute top-3 right-3 rounded-lg bg-accent px-2.5 py-1 text-xs font-bold text-white">
                مميز
              </span>
            )}
          </div>
          <div class="absolute bottom-0 right-0 left-0 p-4 sm:p-5">
            <h3 class="text-lg font-bold text-white sm:text-xl">{anime.title}</h3>
            <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-muted sm:text-sm">
              {anime.description}
            </p>
            <a
              href="#"
              class="mt-3 inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2 text-xs font-medium text-white transition-colors hover:bg-accent-hover sm:mt-4 sm:px-5 sm:py-2.5 sm:text-sm"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="text-white">
                <path d="M8 5v14l11-7z" fill="currentColor" />
              </svg>
              شاهد الآن
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
