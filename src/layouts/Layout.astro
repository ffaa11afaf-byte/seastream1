---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SeaStream — شاهد أفضل الأنمي",
  description = "SeaStream هو وجهتك لمشاهدة أفضل مسلسلات وأفلام الأنمي بجودة عالية مع ترجمة احترافية.",
} = Astro.props;
---

<!doctype html>
<html lang="ar" dir="rtl" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-bg text-text antialiased">
    <!-- sticky header -->
    <header
      class="sticky top-0 z-50 border-b border-border-subtle/60 bg-bg/80 backdrop-blur-xl"
    >
      <nav
        class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6"
      >
        <!-- logo -->
        <a href="/" class="flex items-center gap-2.5">
          <span
            class="grid h-9 w-9 place-items-center rounded-xl bg-accent shadow-lg shadow-accent/40"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-white">
              <path
                d="M12 3c-3 4-6 6-6 10a6 6 0 0 0 12 0c0-4-3-6-6-10z"
                fill="currentColor"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
              ></path>
            </svg>
          </span>
          <span class="text-xl font-bold tracking-tight text-accent">SeaStream</span>
        </a>

        <!-- search + login -->
        <div class="flex items-center gap-2 sm:gap-3">
          <!-- search icon button -->
          <button
            type="button"
            aria-label="بحث"
            class="grid h-10 w-10 place-items-center rounded-lg border border-border-strong text-muted transition-colors hover:border-accent hover:text-accent"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <circle
                cx="11"
                cy="11"
                r="7"
                stroke="currentColor"
                stroke-width="2"></circle>
              <path
                d="M21 21l-4.3-4.3"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"></path>
            </svg>
          </button>

          <!-- login button -->
          <a href="/login" class="btn-accent">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="text-white">
              <path
                d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l-5-5 5-5M5 12h12"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            تسجيل الدخول
          </a>
        </div>
      </nav>
    </header>

    <slot />
  </body>
</html>
