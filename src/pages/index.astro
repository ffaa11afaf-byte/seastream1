    rating: "9.4",
  },
];

const defaultPopularAnime: PopularAnime[] = [
  {
    title: "مذكرة الموت",
    genre: "غموض · نفسي",
    poster:
      "https://images.pexels.com/photos/207962/pexels-photo-207962.jpeg?auto=compress&cs=tinysrgb&w=600",
