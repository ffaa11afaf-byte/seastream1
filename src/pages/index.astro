    poster:
      "https://images.pexels.com/photos/164821/pexels-photo-164821.jpeg?auto=compress&cs=tinysrgb&w=600",
    rating: "8.8",
  },
  {
    title: "نينجا كاموي",
    genre: "أكشن · إثارة",
    poster:
      "https://images.pexels.com/photos/1108544/pexels-photo-1108544.jpeg?auto=compress&cs=tinysrgb&w=600",
    rating: "8.6",
