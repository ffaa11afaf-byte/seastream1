---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import HeroSliderSection from "../components/HeroSliderSection.astro";
import EpisodeCard from "../components/EpisodeCard.astro";
import AnimeCard from "../components/AnimeCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import type { FeaturedAnime, Episode, PopularAnime } from "../components/types";
import { db } from "../lib/firebase";
import { collection, getDocs } from "firebase/firestore";

// جلب الأنميات الديناميكية من Firebase
let firebaseAnimeList: PopularAnime[] = [];

try {
  const querySnapshot = await getDocs(collection(db, "anime"));
  firebaseAnimeList = querySnapshot.docs.map((doc) => {
    const data = doc.data();
    return {
      title: data.title || "عنوان غير معروف",
      genre: data.genre || "أكشن · دراما",
      poster: data.poster || "https://images.pexels.com/photos/164821/pexels-photo-164821.jpeg?auto=compress&cs=tinysrgb&w=600",
      rating: data.rating || "8.0",
    };
  });
} catch (error) {
  console.error("خطأ في جلب البيانات من Firebase:", error);
}

const featuredAnime: FeaturedAnime[] = [
  {
    title: "هجوم العمالقة",
    description:
      "في عالم تحاصره العمالقة التي تلتهم البشر، يقاتل إيرين وصديقاه للكشف عن الحقيقة المظلمة وراء الأسوار التي تحميهم.",
    poster:
      "https://images.pexels.com/photos/164821/pexels-photo-164821.jpeg?auto=compress&cs=tinysrgb&w=1200",
    rating: "9.1",
  },
  {
    title: "قاتل الشياطين",
    description:
      "بعد فقدانه لعائلته على يد الشياطين، ينضمم تانجيرو إلى فيلق قتلة الشياطين لإنقاذ أخته وإعادة تحويلها لبشر.",
    poster:
      "https://images.pexels.com/photos/723425/pexels-photo-723425.jpeg?auto=compress&cs=tinysrgb&w=1200",
    rating: "8.7",
  },
  {
    title: "ون بيس",
    description:
      "مغامرات لوفي وطاقم قراصنة قبعة القش بحثاً عن الكنز الأسطوري ون بيس ليصبح ملك القراصنة في عالم مليء بالمخاطر.",
    poster:
      "https://images.pexels.com/photos/1000653/pexels-photo-1000653.jpeg?auto=compress&cs=tinysrgb&w=1200",
    rating: "9.0",
  },
];

const latestEpisodes: Episode[] = [
  {
    number: "12",
    title: "النصر الأخير",
    anime: "قاتل الشياطين",
    poster:
      "https://images.pexels.com/photos/723425/pexels-photo-723425.jpeg?auto=compress&cs=tinysrgb&w=600",
    rating: "9.3",
  },
  {
    number: "08",
    title: "السيف المكسور",
    anime: "ساموراي تشامبلو",
    poster:
      "https://images.pexels.com/photos/164821/pexels-photo-164821.jpeg?auto=compress&cs=tinysrgb&w=600",
    rating: "8.5",
  },
  {
    number: "23",
    title: "ما وراء البحر",
    anime: "ون بيس",
    poster:
      "https://images.pexels.com/photos/1000653/pexels-photo-1000653.jpeg?auto=compress&cs=tinysrgb&w=600",
    rating: "9.0",
  },
  {
    number: "05",
    title: "ظلال الماضي",
    anime: "جوجوتسو كايسن",
    poster:
      "https://images.pexels.com/photos/1108544/pexels-photo-1108544.jpeg?auto=compress&cs=tinysrgb&w=600",
    rating: "8.9",
  },
  {
    number: "17",
    title: "الوعد المنسي",
